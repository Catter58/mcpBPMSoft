# Node.js 22+. Сервер читает локальный .env из текущей рабочей папки.
# Переменные окружения имеют приоритет. Реальные .env не включаются в Git.
BPMSOFT_URL=https://bpm.example.ru

# Режим нескольких стендов включается только явно, исключительно для HTTP.
# Без флага используется BPMSOFT_URL и /mcp (также /), tenants-файл игнорируется.
# URL и версии берутся только из operator allowlist; общие env-creds запрещены.
# BPMSOFT_MULTITENANT=true
# Скопируйте examples/tenants.example.json в исключённый из Git state/tenants.local.json.
# BPMSOFT_TENANTS_FILE=./state/tenants.local.json
# Включённый режим: /tenants/<id>/mcp, /mcp и / не выбирают стенд.

# OData: 4 + net8 → /odata; 4 + netframework → /0/odata;
# 3 + netframework → /0/ServiceModel/EntityDataService.svc.
BPMSOFT_ODATA_VERSION=4
BPMSOFT_PLATFORM=net8

# HTTP: сессия пользователя должна приходить с каждым запросом.
MCP_TRANSPORT=http
MCP_HTTP_PORT=8007
MCP_HTTP_HOST=127.0.0.1

# Ограничение HTTP-допуска: активные, ожидающие, активные на auth+tenant context.
# Заполненная очередь → HTTP 429, Retry-After: 1; отключение клиента снимает ожидание.
MCP_MAX_CONCURRENT_REQUESTS=500
MCP_MAX_QUEUED_REQUESTS=500
MCP_MAX_CONCURRENT_PER_SCOPE=50

# Обязательно при bind 0.0.0.0 / другом внешнем интерфейсе.
# Точные Host заголовки, разделённые запятыми (порт включается при необходимости).
# MCP_ALLOWED_HOSTS=mcp.example.ru,127.0.0.1:8007
# Разрешённые browser origins; без настройки совпадают с разрешёнными hosts.
# MCP_ALLOWED_ORIGINS=https://mcp.example.ru

# stdio не передаёт HTTP cookies. Для локального процесса одной учётной записи:
# MCP_TRANSPORT=stdio
# BPMSOFT_ALLOW_ENV_CREDS=true
# BPMSOFT_USERNAME=api-user
# BPMSOFT_PASSWORD=REPLACE_IN_LOCAL_CONFIG
# Env-creds HTTP разрешён только при loopback bind.

# Размер запрашиваемой страницы; итоговый ответ ограничивается инструментом.
BPMSOFT_PAGE_SIZE=5000
# Максимум 100 операций в одной порции $batch.
BPMSOFT_MAX_BATCH_SIZE=100
BPMSOFT_LOOKUP_CACHE_TTL=300
# Таймаут одного HTTP-запроса со всеми его попытками и задержками чтения, ms.
BPMSOFT_REQUEST_TIMEOUT=30000
# Общий бюджет одного readOnlyHint=true tool, включая повторы/redirects:
# миллисекунды, фактические upstream fetch, декодированные байты.
# Отдельный лимит полного MCP-результата чтения остаётся 64 КиБ.
BPMSOFT_READ_BUDGET_TIMEOUT=120000
BPMSOFT_READ_BUDGET_REQUESTS=100
BPMSOFT_READ_BUDGET_BYTES=67108864
BPMSOFT_MAX_FILE_SIZE=10485760
# Подготовленный корень обмена; HTTP относительные пути относятся к
# <root>/<hash tenant ID+URL>/<hash verified BPMSoft user UUID>.
# Каталоги 0700, файлы 0600; другой пользователь/стенд и symlinks не допускаются.
# Старые shared-root файлы оператор переносит только после проверки владельца.
BPMSOFT_FILE_ROOT=./files

# Дисковый журнал изменений. Для одного стенда opt-in; в multitenant режиме
# включён по умолчанию в ./state/operations. Для Docker подключите постоянный
# том, доступный UID/GID 1000, с правами корня 0700. Потерянный ответ: bpm_get_operation.
# BPMSOFT_JOURNAL_ROOT=./state/operations

# 1 — метод, путь, статус. trace — также тела CRM; только контролируемая отладка.
# BPMSOFT_DEBUG=1

# Календарные операторы используют пояс пользователя; это запасной пояс сервера.
BPMSOFT_TIMEZONE=Europe/Moscow

# Дисковый кэш EDMX проверяется ETag, разделён по подключению и авторизации.
# BPMSOFT_METADATA_CACHE=off
# BPMSOFT_METADATA_CACHE_DIR=/var/cache/mcp-bpmsoft
