# Node.js 22+. Сервер читает локальный .env из текущей рабочей папки.
# Переменные окружения имеют приоритет. Реальные .env не включаются в Git.
BPMSOFT_URL=https://bpm.example.ru

# OData: 4 + net8 → /odata; 4 + netframework → /0/odata;
# 3 + netframework → /0/ServiceModel/EntityDataService.svc.
BPMSOFT_ODATA_VERSION=4
BPMSOFT_PLATFORM=net8

# HTTP: сессия пользователя должна приходить с каждым запросом.
MCP_TRANSPORT=http
MCP_HTTP_PORT=8007
MCP_HTTP_HOST=127.0.0.1

# Обязательно при bind 0.0.0.0 / другом внешнем интерфейсе.
# Точные Host заголовки, разделённые запятыми (порт включается при необходимости).
# MCP_ALLOWED_HOSTS=mcp.example.ru,127.0.0.1:8007
# Разрешённые browser origins; без настройки совпадают с разрешёнными hosts.
# MCP_ALLOWED_ORIGINS=https://mcp.example.ru

# stdio не передаёт HTTP cookies. Для локального процесса одной учётной записи:
# MCP_TRANSPORT=stdio
# BPMSOFT_ALLOW_ENV_CREDS=true
# BPMSOFT_USERNAME=api-user
# BPMSOFT_PASSWORD=REPLACE_IN_LOCAL_CONFIG
# Env-creds HTTP разрешён только при loopback bind.

# Размер запрашиваемой страницы; итоговый ответ ограничивается инструментом.
BPMSOFT_PAGE_SIZE=5000
# Максимум 100 операций в одной порции $batch.
BPMSOFT_MAX_BATCH_SIZE=100
BPMSOFT_LOOKUP_CACHE_TTL=300
# Таймаут одного HTTP-запроса со всеми его попытками и задержками чтения, ms.
BPMSOFT_REQUEST_TIMEOUT=30000
BPMSOFT_MAX_FILE_SIZE=10485760
# HTTP-файлы доступны только в этом выделенном каталоге; symlink-выход запрещён.
# Пути файлов в запросах HTTP должны находиться внутри него.
BPMSOFT_FILE_ROOT=./files

# 1 — метод, путь, статус. trace — также тела CRM; только контролируемая отладка.
# BPMSOFT_DEBUG=1

# Календарные операторы используют пояс пользователя; это запасной пояс сервера.
BPMSOFT_TIMEZONE=Europe/Moscow

# Дисковый кэш EDMX проверяется ETag, разделён по подключению и авторизации.
# BPMSOFT_METADATA_CACHE=off
# BPMSOFT_METADATA_CACHE_DIR=/var/cache/mcp-bpmsoft
